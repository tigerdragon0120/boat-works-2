{
  "name": "Daily Auto Update",
  "description": "\u5c55\u793a\u30fb\u30aa\u30c3\u30ba\u30fb\u7d50\u679c\u30fb\u5f53\u65e5/\u7fcc\u65e5\u51fa\u8d70\u8868\u306e\u53ce\u96c6\u5c02\u7528\u3002\u4e88\u60f3\u751f\u6210\u306fV8 Two Stage Forecasts\u306b\u96c6\u7d04\u3057\u3001V6\u4ee5\u524d\u306e\u4e88\u60f3/\u63a1\u70b9\u3092\u81ea\u52d5\u5b9f\u884c\u3057\u306a\u3044\u3002\u6bce\u65e506:00\u301c23:55 JST\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 6-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_auto_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyAutoUpdate",
            "args": {
              "step": "auto"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u6bce\u65e5\u81ea\u52d5\u66f4\u65b0",
            "description": "\u516c\u5f0f\u30c7\u30fc\u30bf\u81ea\u52d5\u53d6\u5f97\u30fb\u4e88\u60f3\u751f\u6210(5\u5206\u6bce)"
          }
        }
      }
    ]
  }
}
{
  "name": "Daily Auto Update",
  "description": "5\u5206\u3054\u3068\u306b\u5c55\u793a\u30fb\u30aa\u30c3\u30ba\u30fb\u7d50\u679c\u30fb\u756a\u7d44\u3092\u53ce\u96c6\u3059\u308b\u53d6\u5f97\u5c02\u7528\u51e6\u7406\u3002\u6bce\u65e506:00\u301c23:55 JST\u3002V8\u4e88\u60f3\u306f\u72ec\u7acb\u3057\u305f\u65e2\u5b58\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3067\u5b9f\u884c\u3057\u3001\u53d6\u5f97\u306e\u7d99\u7d9a\u3068\u5931\u6557\u5c65\u6b74\u3092\u5206\u96e2\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 6-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_auto_update",
      "version": "1.3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyAutoUpdate",
            "args": {
              "step": "auto"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u5c55\u793a\u30fb\u30aa\u30c3\u30ba\u30fb\u7d50\u679c\u3092\u53d6\u5f97",
            "description": "5\u5206\u3054\u3068\u306b\u516c\u5f0f\u30c7\u30fc\u30bf\u3092\u4fdd\u5b58\u3002\u4e88\u60f3\u751f\u6210\u306f\u72ec\u7acb\u3057\u305f\u65e2\u5b58V8\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3067\u5b9f\u884c\u3059\u308b\u3002"
          }
        }
      }
    ]
  }
}
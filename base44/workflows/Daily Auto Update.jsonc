{
  "name": "Daily Auto Update",
  "description": "\u6bce\u65e5boatrace.jp\u516c\u5f0f\u30c7\u30fc\u30bf\u3092\u81ea\u52d5\u53d6\u5f97\u30fb\u66f4\u65b0\u3002\u756a\u7d44\u8868\u30fb\u7d50\u679c\u30fb\u5c55\u793a\u30fbPRE\u4e88\u60f3\u3092\u81ea\u52d5\u51e6\u7406\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_auto_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "auto_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyAutoUpdate",
            "args": {
              "step": "auto"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u6bce\u65e5\u81ea\u52d5\u66f4\u65b0",
            "description": "\u516c\u5f0f\u30c7\u30fc\u30bf\u81ea\u52d5\u53d6\u5f97\u30fb\u4e88\u60f3\u751f\u6210(5\u5206\u6bce)"
          }
        }
      }
    ]
  }
}
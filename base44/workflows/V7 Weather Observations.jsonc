{
  "name": "V7 Weather Observations",
  "description": "\u5834\u5225\u306e\u516c\u5f0f\u98a8\u5411\u30fb\u98a8\u901f\u30fb\u5929\u5019\u3092\u30ec\u30fc\u30b9\u524d\u5f8c\u306e\u89b3\u6e2c\u6642\u523b\u3068\u51fa\u5178\u4ed8\u304d\u3067\u72ec\u7acb\u4fdd\u5b58\u3002\u4e88\u60f3\u6642\u70b9\u306e\u53c2\u7167\u6c17\u8c61\u3068\u7d50\u679c\u6642\u70b9\u306e\u6c17\u8c61\u3092\u533a\u5225\u3057\u3001\u30a4\u30f3\u52dd\u7387\u5206\u6790\u306b\u4f7f\u3046\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "1,6,11,16,21,26,31,36,41,46,51,56 8-21 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "v7_weather_capture",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "capture_weather": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "v7CollectWeather",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u30ec\u30fc\u30b9\u6c34\u9762\u6c17\u8c61\u3092\u53ce\u96c6",
            "description": "\u30ec\u30fc\u30b9\u524d\u306e\u53c2\u7167\u6c17\u8c61\u3068\u30ec\u30fc\u30b9\u5f8c\u306e\u5b9f\u6c17\u8c61\u3092\u6642\u523b\u4ed8\u304d\u3067\u5225\u4fdd\u5b58\u3002V7\u4e88\u60f3\u3092\u5909\u66f4\u3057\u306a\u3044"
          }
        }
      }
    ]
  }

{
  "name": "ResultProvenanceClaim",
  "type": "object",
  "description": "\u7d50\u679c\u306e\u516c\u5f0f\u53d6\u5f97\u7d4c\u8def\u306e\u8a18\u9332(ResultProvenance)\u306e\u767b\u9332\u6a29\u3002\u8a3c\u8de1\u30ad\u30fc(evidence_hash::evidence_type)\u3054\u3068\u306b1\u4ef6\u3060\u3051\u3092\u6b63\u3068\u3057\u3001free \u2192 writing \u2192 written \u306e\u72b6\u614b\u9077\u79fb\u3092\u6761\u4ef6\u4ed8\u304d\u66f8\u8fbc(CAS)\u3067\u884c\u3046\u3002\u72b6\u614b\u9077\u79fb\u304c\u6210\u7acb\u3057\u305f1\u3064\u306e\u547c\u3073\u51fa\u3057\u3060\u3051\u304cResultProvenance\u3078\u66f8\u304d\u8fbc\u3081\u308b\u305f\u3081\u3001\u540c\u3058\u8a3c\u8de1\u306e\u8a18\u9332\u306f1\u4ef6\u306b\u4fdd\u305f\u308c\u308b(DB\u306e\u4e00\u610f\u5236\u7d04\u304c\u4f7f\u3048\u306a\u3044\u305f\u3081\u3001\u540c\u3058claim_key\u306e\u884c\u304c\u8907\u6570\u3042\u308b\u5834\u5408\u306f\u78ba\u5b9a\u884c\u3092\u6b63\u3068\u3057\u3001\u672a\u53d6\u5f97\u884c\u3092\u524a\u9664\u3057\u30661\u884c\u306b\u63c3\u3048\u308b)\u3002\u66f8\u8fbc\u306f\u30b5\u30fc\u30d0\u30fc\u306e\u5171\u901a\u4fdd\u5b58\u51e6\u7406(resultProvenance)\u306e\u307f\u3002",
  "properties": {
    "claim_key": {
      "type": "string",
      "description": "\u8a3c\u8de1\u30ad\u30fc evidence_hash::evidence_type(\u3053\u306e\u5358\u4f4d\u30671\u4ef6\u306e\u307f)"
    },
    "race_id": {
      "type": "string"
    },
    "evidence_hash": {
      "type": "string",
      "description": "\u5bfe\u8c61\u306e\u8a3c\u8de1\u306e\u4e00\u610f\u30ad\u30fc(ResultProvenance.evidence_hash)"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "LIVE",
        "BACKFILL"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "description": "LIVE=\u5b9f\u53d6\u5f97\u306e\u8a18\u9332 / BACKFILL=\u4e8b\u5f8c\u88dc\u5b8c\u306e\u8a18\u9332"
    },
    "state": {
      "type": "string",
      "enum": [
        "free",
        "writing",
        "written"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "free",
      "description": "free=\u672a\u53d6\u5f97 / writing=\u66f8\u8fbc\u4e2d(lease\u4e2d\u306f\u4ed6\u306e\u51e6\u7406\u306f\u4fdd\u5b58\u3057\u306a\u3044) / written=\u8a3c\u8de1\u306e\u4fdd\u5b58\u307e\u3067\u78ba\u5b9a"
    },
    "owner": {
      "type": "string",
      "description": "\u66f8\u8fbc\u4e2d\u306e\u53d6\u5f97\u30c8\u30fc\u30af\u30f3(evidence_hash+\u4e71\u6570)\u3002\u6240\u6709\u6a29\u306e\u78ba\u8a8d\u3068\u89e3\u653e\u306e\u6761\u4ef6\u306b\u4f7f\u3046"
    },
    "provenance_id": {
      "type": "string",
      "description": "\u78ba\u5b9a\u3057\u305fResultProvenance\u306e\u30ec\u30b3\u30fc\u30c9ID"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u53d6\u5f97\u6642\u523b\u3002writing\u304c\u3053\u306e\u6642\u523b\u304b\u3089\u4e00\u5b9a\u6642\u9593\u9032\u307e\u306a\u3044\u5834\u5408\u306f\u3001\u5225\u306e\u51e6\u7406\u304c\u5f15\u304d\u7d99\u3050"
    }
  },
  "required": [
    "claim_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
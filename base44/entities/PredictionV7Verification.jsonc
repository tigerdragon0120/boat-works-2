{
  "name": "PredictionV7Verification",
  "type": "object",
  "description": "\u7d71\u5408V7\u306e\u4e88\u60f3\u3092\u78ba\u5b9a\u7d50\u679c\u3068\u7167\u5408\u3057\u305f\u691c\u8a3c\u7d50\u679c\u30021\u4e88\u60f3\u30ec\u30b3\u30fc\u30c9\u306b\u3064\u304d1\u4ef6\u3002\u7de0\u5207\u524d\u306eDB\u4fdd\u5b58\u30fb\u8a18\u9332\u56fa\u5b9a\u30fb\u7d50\u679c\u78ba\u5b9a\u3092\u30b5\u30fc\u30d0\u30fc\u5074\u3067\u78ba\u8a8d\u3057\u305f\u3082\u306e\u3060\u3051\u3092\u4fdd\u5b58\u3059\u308b\u3002",
  "properties": {
    "record_hash": {
      "type": "string",
      "description": "\u5bfe\u8c61\u306ePredictionV7.record_hash"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "model": {
      "type": "string",
      "enum": [
        "OPEN",
        "WOMENS"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ],
      "enumColors": [
        "gray",
        "green"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u4e88\u60f3\u306e\u751f\u6210\u6642\u523b(\u30d6\u30e9\u30a6\u30b6\u7533\u544a\u5024\u30fb\u53c2\u8003\u60c5\u5831)"
    },
    "actual_result": {
      "type": "string",
      "description": "\u78ba\u5b9a\u3057\u305f\u4e09\u9023\u5358"
    },
    "actual_first_boat": {
      "type": "number"
    },
    "top_hit": {
      "type": "boolean",
      "description": "\u672c\u547d\u4e09\u9023\u5358\u304c\u7684\u4e2d\u3057\u305f\u304b"
    },
    "rank_hits": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "description": "1\u301c3\u7740\u306e\u4e88\u60f3\u304c\u5f53\u305f\u3063\u305f\u304b"
    },
    "plans": {
      "type": "array",
      "description": "\u8cb7\u3044\u76ee\u3054\u3068\u306e\u7684\u4e2d\u30fb\u6295\u8cc7\u30fb\u6255\u623b",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "tickets": {
            "type": "number"
          },
          "probability": {
            "type": "number"
          },
          "judgment": {
            "type": "string"
          },
          "hit": {
            "type": "boolean"
          },
          "investment": {
            "type": "number"
          },
          "payout": {
            "type": "number"
          },
          "recovery": {
            "type": "number"
          }
        }
      }
    },
    "record_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "DB\u304c\u8a18\u9332\u3057\u305f\u4fdd\u5b58\u6642\u523b(\u7de0\u5207\u524d\u5224\u5b9a\u306e\u6839\u62e0)"
    },
    "record_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u6700\u5f8c\u306e\u66f4\u65b0\u6642\u523b(\u8a18\u9332\u56fa\u5b9a\u306e\u5224\u5b9a\u306b\u4f7f\u7528)"
    },
    "race_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Race\u306b\u4fdd\u5b58\u3055\u308c\u305f\u7de0\u5207(\u30b5\u30fc\u30d0\u30fc\u5074\u306e\u5224\u5b9a\u57fa\u6e96)"
    },
    "pre_deadline_verified": {
      "type": "boolean",
      "description": "\u7de0\u5207\u524d\u306eDB\u4fdd\u5b58\u3092\u30b5\u30fc\u30d0\u30fc\u5074\u3067\u78ba\u8a8d\u6e08\u307f"
    },
    "record_fixed": {
      "type": "boolean",
      "description": "\u4fdd\u5b58\u5f8c\u306b\u66f8\u304d\u63db\u3048\u3089\u308c\u3066\u3044\u306a\u3044\u3053\u3068\u3092\u78ba\u8a8d\u6e08\u307f"
    },
    "result_status": {
      "type": "string",
      "description": "\u7167\u5408\u306b\u4f7f\u3063\u305f\u7d50\u679c\u306e\u72b6\u614b"
    },
    "result_finished": {
      "type": "boolean",
      "description": "\u78ba\u5b9a\u7d50\u679c\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u6e08\u307f"
    },
    "payout": {
      "type": "number",
      "description": "\u78ba\u5b9a\u6255\u623b(\u4e09\u9023\u5358\u30fb100\u5186\u3042\u305f\u308a)"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "record_hash",
    "race_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
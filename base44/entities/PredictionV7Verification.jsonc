{
  "name": "PredictionV7Verification",
  "type": "object",
  "description": "\u7d71\u5408V7\u306e\u4e88\u60f3\u3092\u78ba\u5b9a\u7d50\u679c\u3068\u7167\u5408\u3057\u305f\u8a18\u9332\u3002\u4e88\u60f31\u4ef6(record_hash)\u306b\u3064\u304d\u6700\u65b0\u306e1\u4ef6\u3060\u3051\u3092\u73fe\u5728\u306e\u5224\u5b9a\u3068\u3057\u3066\u6271\u3044\u3001\u8a18\u9332\u306f\u8ffd\u8a18\u306e\u307f\u3067\u66f8\u304d\u63db\u3048\u306a\u3044\u3002\u96c6\u8a08\u5358\u4f4d\u306f\u30ec\u30fc\u30b9\u00d7\u6bb5\u968e\u3054\u3068\u306e\u4ee3\u8868\u4e88\u60f3(\u6700\u521d\u306b\u4fdd\u5b58\u3055\u308c\u305f1\u4ef6)\u3067\u3001\u5f8c\u304b\u3089\u4fdd\u5b58\u3055\u308c\u305f\u91cd\u8907(\u5f8c\u767a\u306e\u91cd\u8907)\u306fDUPLICATE\u3068\u3057\u3066\u8a18\u9332\u3057\u3001\u7684\u4e2d\u7387\u30fb\u56de\u53ce\u7387\u304b\u3089\u9664\u5916\u3059\u308b\u3002\u6255\u623b\u4e0d\u8db3\u30fb\u7de0\u5207\u4e0d\u660e\u306f\u88dc\u5b8c\u5f8c\u306b\u518d\u5224\u5b9a\u3057\u3001\u5224\u5b9a\u304c\u5909\u308f\u3063\u305f\u3068\u304d\u3060\u3051\u65b0\u3057\u3044\u884c\u3092\u8ffd\u8a18\u3059\u308b\u3002verification_version \u304c\u7121\u3044\u884c\u306f\u65e7\u65b9\u5f0f\u306e\u8a18\u9332\u3067\u3001\u6210\u7e3e\u306f\u5225\u96c6\u8a08\u3068\u3057\u3066\u6271\u3046\u3002",
  "properties": {
    "record_hash": {
      "type": "string",
      "description": "\u5bfe\u8c61\u306ePredictionV7.record_hash(\u5f8c\u767a\u306e\u91cd\u8907\u3082\u305d\u306e\u884c\u81ea\u8eab\u306ehash)"
    },
    "verification_version": {
      "type": "string",
      "default": "v2",
      "description": "\u7167\u5408\u65b9\u5f0f\u3002v2=\u5224\u5b9a\u72b6\u614b\u4ed8\u304d\u306e\u65b0\u65b9\u5f0f\u3002\u672a\u8a2d\u5b9a\u306e\u884c\u306f\u65e7\u65b9\u5f0f\u306e\u8a18\u9332\u3067\u5909\u66f4\u3057\u306a\u3044"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "HELD_DUPLICATE",
        "HELD_LATE",
        "HELD_DEADLINE_UNKNOWN",
        "HELD_TIME_CONFLICT",
        "HELD_PAYOUT_MISSING",
        "HELD_TICKETS_MISSING",
        "HELD_RACE_MISMATCH"
      ],
      "enumColors": [
        "green",
        "red",
        "red",
        "yellow",
        "red",
        "yellow",
        "yellow",
        "red"
      ],
      "description": "VERIFIED=\u6709\u52b9\u691c\u8a3c(\u7684\u4e2d\u7387\u30fb\u56de\u53ce\u7387\u306e\u5bfe\u8c61) / HELD_*=\u4fdd\u7559(\u96c6\u8a08\u304b\u3089\u9664\u5916)"
    },
    "hold_reason": {
      "type": "string",
      "enum": [
        "DUPLICATE",
        "LATE",
        "DEADLINE_UNKNOWN",
        "TIME_CONFLICT",
        "PAYOUT_MISSING",
        "TICKETS_MISSING",
        "RACE_MISMATCH"
      ],
      "enumColors": [
        "red",
        "red",
        "yellow",
        "red",
        "yellow",
        "yellow",
        "red"
      ],
      "description": "\u4fdd\u7559\u306e\u4e3b\u7406\u7531(\u7406\u7531\u5225\u96c6\u8a08\u306b\u4f7f\u7528)\u3002PAYOUT_MISSING\u30fbDEADLINE_UNKNOWN\u306f\u88dc\u5b8c\u5f8c\u306b\u518d\u5224\u5b9a\u3059\u308b"
    },
    "hold_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u8a72\u5f53\u3057\u305f\u4fdd\u7559\u7406\u7531\u306e\u5168\u4ef6"
    },
    "duplicate_count": {
      "type": "number",
      "description": "\u540c\u4e00\u30ec\u30fc\u30b9\u00d7\u6bb5\u968e\u3067\u898b\u3064\u304b\u3063\u305f\u4e88\u60f3\u306e\u4ef6\u6570(\u91cd\u8907\u6642)"
    },
    "duplicate_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u540c\u3058\u30ec\u30fc\u30b9\u00d7\u6bb5\u968e\u306e\u4e88\u60f3record_hash(\u6700\u592710\u4ef6)"
    },
    "duplicate_of": {
      "type": "string",
      "description": "\u5f8c\u767a\u306e\u91cd\u8907\u306e\u3068\u304d\u3001\u4ee3\u8868(\u6700\u521d\u306b\u4fdd\u5b58\u3055\u308c\u305f\u4e88\u60f3)\u306erecord_hash"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "model": {
      "type": "string",
      "enum": [
        "OPEN",
        "WOMENS"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ],
      "enumColors": [
        "gray",
        "green"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u4e88\u60f3\u306e\u751f\u6210\u6642\u523b(\u4e88\u60f3\u5074\u306e\u7533\u544a\u5024\u30fb\u53c2\u8003\u60c5\u5831)"
    },
    "actual_result": {
      "type": "string",
      "description": "\u78ba\u5b9a\u3057\u305f\u4e09\u9023\u5358"
    },
    "actual_first_boat": {
      "type": "number"
    },
    "top_hit": {
      "type": "boolean",
      "description": "\u672c\u547d\u4e09\u9023\u5358\u304c\u7684\u4e2d\u3057\u305f\u304b(\u6709\u52b9\u691c\u8a3c\u306e\u307f)"
    },
    "rank_hits": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "description": "1\u301c3\u7740\u306e\u4e88\u60f3\u304c\u5f53\u305f\u3063\u305f\u304b(\u6709\u52b9\u691c\u8a3c\u306e\u307f)"
    },
    "plans": {
      "type": "array",
      "description": "\u8cb7\u3044\u76ee\u3054\u3068\u306e\u7684\u4e2d\u30fb\u6295\u8cc7\u30fb\u6255\u623b(\u6709\u52b9\u691c\u8a3c\u306e\u307f)",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "tickets": {
            "type": "number"
          },
          "probability": {
            "type": "number"
          },
          "judgment": {
            "type": "string"
          },
          "hit": {
            "type": "boolean"
          },
          "investment": {
            "type": "number"
          },
          "payout": {
            "type": "number"
          },
          "recovery": {
            "type": "number"
          }
        }
      }
    },
    "record_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "DB\u304c\u8a18\u9332\u3057\u305f\u4e88\u60f3\u306e\u4fdd\u5b58\u6642\u523b(\u4ee3\u8868\u306e\u5224\u5b9a\u3068\u7de0\u5207\u524d\u5224\u5b9a\u306e\u6839\u62e0)"
    },
    "record_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u4e88\u60f3\u306e\u6700\u7d42\u66f4\u65b0\u6642\u523b(\u8a18\u9332\u56fa\u5b9a\u306e\u5224\u5b9a\u306b\u4f7f\u7528)"
    },
    "race_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Race\u306b\u4fdd\u5b58\u3055\u308c\u305f\u7de0\u5207(\u30b5\u30fc\u30d0\u30fc\u5074\u306e\u5224\u5b9a\u57fa\u6e96)"
    },
    "pre_deadline_verified": {
      "type": "boolean",
      "description": "\u7de0\u5207\u524d\u306eDB\u4fdd\u5b58\u3092\u30b5\u30fc\u30d0\u30fc\u5074\u3067\u78ba\u8a8d\u6e08\u307f"
    },
    "record_fixed": {
      "type": "boolean",
      "description": "\u4fdd\u5b58\u5f8c\u306b\u66f8\u304d\u63db\u3048\u3089\u308c\u3066\u3044\u306a\u3044\u3053\u3068\u3092\u78ba\u8a8d\u6e08\u307f"
    },
    "result_status": {
      "type": "string",
      "description": "\u7167\u5408\u306b\u4f7f\u3063\u305f\u7d50\u679c\u306e\u72b6\u614b"
    },
    "result_finished": {
      "type": "boolean",
      "description": "\u78ba\u5b9a\u7d50\u679c\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u6e08\u307f"
    },
    "payout": {
      "type": "number",
      "description": "\u78ba\u5b9a\u6255\u623b(\u4e09\u9023\u5358\u30fb100\u5186\u3042\u305f\u308a)"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u7167\u5408\u3092\u5b9f\u884c\u3057\u305f\u6642\u523b(\u4fdd\u7559\u306e\u8a18\u9332\u3067\u3082\u5165\u308b\u3002\u518d\u5224\u5b9a\u306f\u65b0\u3057\u3044\u884c\u3068\u3057\u3066\u8ffd\u8a18)"
    }
  },
  "required": [
    "record_hash",
    "race_key"
  ],
  "rls": {

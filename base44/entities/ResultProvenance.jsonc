{
  "name": "ResultProvenance",
  "type": "object",
  "description": "\u4fdd\u5b58\u3055\u308c\u305f\u30ec\u30fc\u30b9\u7d50\u679c(RaceResult)\u304c\u3001\u3069\u306e\u516c\u5f0f\u53d6\u5f97\u7d4c\u8def\u304b\u3089\u3044\u3064\u53d6\u5f97\u3055\u308c\u305f\u304b\u3092\u88cf\u4ed8\u3051\u308b\u8a18\u9332\u3002\u7d50\u679c\u3092\u4fdd\u5b58\u3059\u308b\u3068\u304d\u3001\u5b9f\u969b\u306b\u53d6\u5f97\u3057\u305f\u30c7\u30fc\u30bf\u304c\u305d\u306e\u307e\u307e\u4fdd\u5b58\u3055\u308c\u305f\u5834\u5408\u306b\u3060\u3051\u5b9f\u53d6\u5f97\u306e\u8a3c\u8de1(LIVE)\u3092\u6b8b\u3057\u3001\u53d6\u5f97\u5143(BOATCAST / LOCAL / TXT)\u30fb\u4e09\u9023\u5358\u30fb\u7d50\u679cID\u30fb\u5b9f\u53d6\u5f97\u6642\u523b\u30fb\u53d6\u5f97\u6642\u523b\u3092\u30bb\u30c3\u30c8\u3067\u8a18\u9332\u3059\u308b\u3002\u65e2\u5b58\u7d50\u679c\u306e\u518d\u5229\u7528\u3067\u306f\u8a18\u9332\u3057\u306a\u3044\u3002\u53d6\u5f97\u6642\u306e\u8a18\u9332\u304c\u7121\u3044\u904e\u53bb\u5206\u306f\u3001\u4fdd\u5b58\u6e08\u307f\u7d50\u679c\u304b\u3089\u4e8b\u5f8c\u88dc\u5b8c(BACKFILL)\u3068\u3057\u30661\u4ef6\u3060\u3051\u4f5c\u6210\u3059\u308b\u3002\u7684\u4e2d\u5224\u5b9a\u306b\u306fLIVE\u8a18\u9332\u306e\u307f\u3092\u4f7f\u3044\u3001\u7d50\u679cID\u3068\u4e09\u9023\u5358\u30fb\u53d6\u5f97\u5143\u304c\u4e00\u81f4\u3057\u5b9f\u53d6\u5f97\u6642\u523b\u304c\u3042\u308b\u3053\u3068\u3092\u5fc5\u9808\u3068\u3059\u308b\u3002\u66f8\u304d\u8fbc\u307f\u306f\u30b5\u30fc\u30d0\u30fc\u306e\u5171\u901a\u4fdd\u5b58\u51e6\u7406\u306e\u307f\u3002",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "result_id": {
      "type": "string",
      "description": "\u88cf\u4ed8\u3051\u5bfe\u8c61\u306eRaceResult\u306eID(\u5224\u5b9a\u3067\u306f\u4e00\u81f4\u3092\u5fc5\u9808\u3068\u3059\u308b)"
    },
    "result_trifecta": {
      "type": "string",
      "description": "\u8a18\u9332\u3057\u305f\u78ba\u5b9a\u4e09\u9023\u5358(\u4f8b 1-3-5)"
    },
    "source": {
      "type": "string",
      "enum": [
        "BOATCAST",
        "LOCAL",
        "TXT"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "description": "\u516c\u5f0f\u53d6\u5f97\u7d4c\u8def\u3002BOATCAST=BOATCAST\u914d\u4fe1 / LOCAL=boatrace.jp\u516c\u5f0f / TXT=\u516c\u5f0f\u30d5\u30a1\u30a4\u30eb\u53d6\u8fbc"
    },
    "endpoint": {
      "type": "string",
      "description": "\u53d6\u5f97\u3057\u305f\u7d4c\u8def\u306e\u8b58\u5225\u5b50(\u4f8b boatcast:RS1+RS2 / boatrace.jp:result-html / official_file:import / backfill:stored_result)"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u7d50\u679c\u5074\u304c\u8a18\u9332\u3057\u305f\u78ba\u5b9a\u6642\u523b"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u516c\u5f0f\u30c7\u30fc\u30bf\u3092\u5b9f\u969b\u306b\u53d6\u5f97\u3057\u305f\u6642\u523b(\u5b9f\u53d6\u5f97\u6642\u523b)\u3002LIVE\u8a18\u9332\u3067\u306f\u5fc5\u9808\u3067\u3001\u4e8b\u5f8c\u88dc\u5b8c\u3067\u306f\u7a7a"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u3053\u306e\u88cf\u4ed8\u3051\u8a18\u9332\u3092\u4f5c\u6210\u3057\u305f\u6642\u523b"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "LIVE",
        "BACKFILL"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "description": "LIVE=\u7d50\u679c\u306e\u53d6\u5f97\u6642\u306b\u8a18\u9332 / BACKFILL=\u53d6\u5f97\u6642\u306e\u8a18\u9332\u304c\u7121\u304f\u3001\u4fdd\u5b58\u6e08\u307f\u7d50\u679c\u304b\u3089\u4e8b\u5f8c\u88dc\u5b8c"
    },
    "evidence_hash": {
      "type": "string",
      "description": "race_id\u30fb\u4e09\u9023\u5358\u30fb\u53d6\u5f97\u5143\u30fb\u78ba\u5b9a\u6642\u523b\u304b\u3089\u4f5c\u308b\u4e00\u610f\u30ad\u30fc(\u540c\u3058\u8a18\u9332\u3092\u5897\u3084\u3055\u306a\u3044)"
    }
  },
  "required": [
    "race_id",
    "evidence_hash"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {

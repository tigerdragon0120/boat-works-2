{
  "name": "V7FeatureSnapshot",
  "type": "object",
  "description": "V7\u524d\u5411\u304d\u56e0\u5b50\u53ce\u96c6\u53f0\u5e33\u3002\u4e88\u60f3\u6642\u70b9\u306e\u30aa\u30c3\u30ba\u30fb\u5c55\u793a\u30fb\u30e2\u30fc\u30bf\u30fc\u30fb\u7bc0\u9593\u9806\u4f4d\u30fb\u958b\u50ac\u5834\u6c17\u8c61\u3068\u6b20\u640d\u3092\u56fa\u5b9a\u4fdd\u5b58\u3002\u65e2\u5b58V7\u4e88\u60f3\u3084BUY\u306f\u5909\u3048\u306a\u3044\u3002\u8ffd\u8a18\u306e\u307f\u3002",
  "properties": {
    "original_exhibition": {
      "type": "object",
      "description": "V8研究用の公式オリジナル展示。後着した数値は別キーで追記し、過去観測は更新しない。"
    },
    "snapshot_key": {
      "type": "string",
      "description": "race_key\u3068PRE/FINAL/LOCK\u3067\u4e00\u610f\u3068\u306a\u308b\u8ad6\u7406\u30ad\u30fc"
    },
    "schema_version": {
      "type": "string"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "snapshot_stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL",
        "LOCK"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "QUALIFYING",
        "SEMIFINAL",
        "FINAL",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "series_day": {
      "type": "number"
    },
    "race_type": {
      "type": "string"
    },
    "series_name": {
      "type": "string"
    },
    "gender_model": {
      "type": "string",
      "enum": [
        "OPEN",
        "WOMENS",
        "UNKNOWN"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "prediction_id": {
      "type": "string"
    },
    "prediction_hash": {
      "type": "string"
    },
    "prediction_stage": {
      "type": "string"
    },
    "prediction_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_judgment": {
      "type": "string"
    },
    "pre_top_combination": {
      "type": "string"
    },
    "final_top_combination": {
      "type": "string"
    },
    "top_changed": {
      "type": "boolean"
    },
    "wind_dir": {
      "type": "string"
    },
    "wind_speed": {
      "type": "number"
    },
    "weather": {
      "type": "string"
    },
    "wave_height": {
      "type": "number"
    },
    "water_temp": {
      "type": "number"
    },
    "air_temp": {
      "type": "number"
    },
    "weather_complete": {
      "type": "boolean"
    },
    "qualifying_rank_complete": {
      "type": "boolean"
    },
    "boats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "market": {
      "type": "object"
    },
    "signals": {
      "type": "object"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "CAPTURED",
        "PARTIAL"
      ]
    }
  },
  "required": [
    "snapshot_key",
    "schema_version",
    "race_id",
    "race_key",
    "race_date",
    "snapshot_stage",
    "observed_at",
    "deadline",
    "phase",
    "gender_model",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
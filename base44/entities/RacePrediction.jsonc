{
  "name": "RacePrediction",
  "type": "object",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ]
    },
    "prediction_version": {
      "type": "string",
      "default": "v1"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "prediction_grade": {
      "type": "string",
      "enum": [
        "S",
        "A",
        "B",
        "C"
      ]
    },
    "data_confidence": {
      "type": "number",
      "description": "\u30c7\u30fc\u30bf\u4fe1\u983c\u5ea6 0-100"
    },
    "honmei_boat": {
      "type": "number"
    },
    "taiko_boat": {
      "type": "number"
    },
    "ana_boat": {
      "type": "number"
    },
    "keshi_boat": {
      "type": "number"
    },
    "top_trifecta": {
      "type": "string"
    },
    "top_probability": {
      "type": "number"
    },
    "top_odds": {
      "type": "number"
    },
    "top_expected_value": {
      "type": "number"
    },
    "top_judgment": {
      "type": "string",
      "enum": [
        "STRONG_BUY",
        "BUY",
        "WATCH",
        "SKIP"
      ]
    },
    "race_scenario": {
      "type": "object",
      "description": "\u5c55\u958b\u4e88\u6e2c",
      "properties": {
        "primary": {
          "type": "string",
          "description": "\u4e3b\u8981\u5c55\u958b"
        },
        "secondary": {
          "type": "string",
          "description": "\u526f\u6b21\u5c55\u958b"
        },
        "confidence": {
          "type": "number",
          "description": "\u5c55\u958b\u4fe1\u983c\u5ea60-100"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "first_ranking": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "1\u7740\u5019\u88dc\u9806\u4f4d(\u8247\u756a\u914d\u5217)"
    },
    "second_ranking": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "2\u7740\u5019\u88dc\u9806\u4f4d(\u8247\u756a\u914d\u5217)"
    },
    "third_ranking": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "3\u7740\u5019\u88dc\u9806\u4f4d(\u8247\u756a\u914d\u5217)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "MISSING"
      ],
      "default": "COMPLETED"
    }
  },
  "required": [
    "race_id",
    "stage",
    "prediction_version"
  ]
}
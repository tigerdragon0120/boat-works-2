{
  "name": "V8RaceForecast",
  "type": "object",
  "description": "\u524d\u65e5\u30fb\u5c55\u793a\u524d\u30fb\u5c55\u793a\u5f8c\u306e\u5c55\u958b\u4e88\u60f3\u3092\u4e0d\u5909\u4fdd\u5b58\u3002\u7de0\u5207\u524d\u306eLIVE\u3068\u6b20\u843d\u88dc\u5b8c\u306eREPLAY\u3092\u533a\u5225\u3057\u3001\u5168\u30ec\u30fc\u30b9\u306e\u6bb5\u968e\u5225\u691c\u8a3c\u306b\u5229\u7528\u3059\u308b\u3002",
  "properties": {
    "racer_evidence": {
      "type": "object",
      "description": "予想時点で固定した選手別の公式コース成績、母数補正、艇番別の蓄積実績と参照元。事前資料の再利用・進入変更・展示追加を区別する。"
    },
    "original_exhibition": {
      "type": "object",
      "description": "予想生成時に照合したオリジナル展示の固定記録。結果を含まない。"
    },
    "sum_evidence": {
      "type": "object",
      "description": "基本SUMと確認済み場別合算の保存値・出走艇平均との差・適用状態。買い目への変換は独自研究ルール。"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "DAY_BEFORE",
        "PRE",
        "FINAL"
      ]
    },
    "forecast_key": {
      "type": "string"
    },
    "input_as_of": {
      "type": "string"
    },
    "top_scenario_key": {
      "type": "string"
    },
    "quality": {
      "type": "string"
    },
    "gender_model": {
      "type": "string"
    },
    "score_type": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority_score": {
      "type": "number"
    },
    "exhibition_complete": {
      "type": "boolean"
    },
    "research_tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "展開候補ごとにtickets・ticket_revision・ticket_basisを予想と同時に保存する。全体買い目research_ticketsとは独立。"
    },
    "comparison": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    },
    "conditions": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "record_mode": {
      "type": "string",
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "description": "LIVE=\u7de0\u5207\u524d\u306e\u5b9f\u4fdd\u5b58\u3002REPLAY=\u6b20\u843d\u3057\u305f\u6bb5\u968e\u3092\u4e8b\u5f8c\u306b\u518d\u69cb\u6210\u3057\u305f\u691c\u8a3c\u7528\u4e88\u60f3\u3002\u65e7\u8a18\u9332\u306e\u672a\u6307\u5b9a\u306fLIVE\u3002"
    },
    "input_snapshot": {
      "type": "object",
      "description": "\u518d\u69cb\u6210\u306b\u5b9f\u969b\u306b\u4f7f\u3063\u305f\u5165\u529b\u3002\u7d50\u679c\u3068\u6255\u623b\u306f\u542b\u307e\u306a\u3044\u3002\u751f\u6210\u6642\u523b\u3092\u9061\u3089\u305b\u306a\u3044\u3002"
    }
  },
  "required": [
    "forecast_key",
    "revision",
    "race_id",
    "race_key",
    "race_date",
    "stage",
    "deadline",
    "generated_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}

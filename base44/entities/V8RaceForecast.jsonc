{
  "name": "V8RaceForecast",
  "type": "object",
  "description": "\u524d\u65e5\u30fb\u5c55\u793a\u524d\u30fb\u5c55\u793a\u5f8c\u306e\u4e0d\u5909\u5c55\u958b\u4e88\u60f3\u3002\u5c55\u793a\u5f8c\u306f\u4fdd\u5b58\u6e08\u307f\u57fa\u6e96\u3092\u53c2\u7167\u3057\u6bd4\u8f03\u3002\u7814\u7a76\u7528BUY\u306f\u6642\u70b9\u30fb\u30aa\u30c3\u30ba\u4ed8\u304d\u3067\u56fa\u5b9a\u3057\u3001\u6700\u521d\u306eBUY\u3092\u30ec\u30fc\u30b9\u3054\u3068\u306b\u691c\u8a3c\u3059\u308b\u3002",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "DAY_BEFORE",
        "PRE",
        "FINAL"
      ]
    },
    "forecast_key": {
      "type": "string"
    },
    "input_as_of": {
      "type": "string"
    },
    "top_scenario_key": {
      "type": "string"
    },
    "quality": {
      "type": "string"
    },
    "gender_model": {
      "type": "string"
    },
    "score_type": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority_score": {
      "type": "number"
    },
    "exhibition_complete": {
      "type": "boolean"
    },
    "research_tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "comparison": {
      "type": "object"
    },
    "decision": {
      "type": "object"
    },
    "conditions": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "forecast_key",
    "revision",
    "race_id",
    "race_key",
    "race_date",
    "stage",
    "deadline",
    "generated_at"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
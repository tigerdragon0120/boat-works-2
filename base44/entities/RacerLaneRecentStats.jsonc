{
  "name": "RacerLaneRecentStats",
  "type": "object",
  "description": "\u9078\u624b\u00d7\u67a0\u756a\u3054\u3068\u306e\u76f4\u8fd110\u8d70\u96c6\u8a08\u3002\u4e88\u60f3\u30ed\u30b8\u30c3\u30af\u3068UI\u3067\u4f7f\u7528\u3002\u51fa\u8d70\u8868\u53d6\u8fbc\u5f8c\u306b\u4e8b\u524d\u8a08\u7b97\u3055\u308c\u30ad\u30e3\u30c3\u30b7\u30e5\u3068\u3057\u3066\u4fdd\u5b58\u3055\u308c\u308b\u3002",
  "properties": {
    "registration_number": {
      "type": "string"
    },
    "lane": {
      "type": "number",
      "minimum": 1,
      "maximum": 6
    },
    "race_date": {
      "type": "string",
      "format": "date",
      "description": "\u5bfe\u8c61\u30ec\u30fc\u30b9\u65e5\u4ed8(\u30ad\u30e3\u30c3\u30b7\u30e5\u30ad\u30fc\u69cb\u6210\u8981\u7d20)"
    },
    "race_id": {
      "type": "string",
      "description": "\u5bfe\u8c61Race ID(\u30ad\u30e3\u30c3\u30b7\u30e5\u30ad\u30fc\u69cb\u6210\u8981\u7d20)"
    },
    "venue_code": {
      "type": "string",
      "description": "\u5bfe\u8c61\u7af6\u8247\u5834\u30b3\u30fc\u30c9(\u30ad\u30e3\u30c3\u30b7\u30e5\u30ad\u30fc\u69cb\u6210\u8981\u7d20)"
    },
    "race_number": {
      "type": "number",
      "description": "\u5bfe\u8c61\u30ec\u30fc\u30b9\u756a\u53f7(\u30ad\u30e3\u30c3\u30b7\u30e5\u30ad\u30fc\u69cb\u6210\u8981\u7d20)"
    },
    "sample_count": {
      "type": "number",
      "description": "\u7d71\u8a08\u8a08\u7b97\u306b\u4f7f\u3063\u305f\u5b9f\u52b9\u30b5\u30f3\u30d7\u30eb\u6570(\u6709\u7740\u9806\u3042\u308a)"
    },
    "total_lane_count": {
      "type": "number",
      "description": "\u540c\u67a0\u5168\u8d70\u6570(DQ\u7b49\u542b\u3080)"
    },
    "win_rate": {
      "type": "number",
      "description": "1\u7740\u7387%(\u4e88\u60f3\u30a8\u30f3\u30b8\u30f3\u7528)"
    },
    "winning_rate": {
      "type": "number",
      "description": "\u52dd\u7387(\u7740\u9806\u70b9\u5e73\u5747)=\u7740\u9806\u70b9\u5408\u8a08\u00f7\u6709\u52b9\u51fa\u8d70\u6570"
    },
    "top2_rate": {
      "type": "number"
    },
    "top3_rate": {
      "type": "number"
    },
    "avg_st": {
      "type": "number"
    },
    "avg_start_order": {
      "type": "number"
    },
    "st_rank_sample_count": {
      "type": "number",
      "description": "ST\u9806\u4f4d\u8a08\u7b97\u306b\u4f7f\u3063\u305f\u6709\u52b9\u30b5\u30f3\u30d7\u30eb\u6570"
    },
    "recent3_momentum": {
      "type": "number",
      "description": "\u76f4\u8fd13\u8d70\u306e\u52e2\u3044(\u6b63=\u4e0a\u5411\u304d)"
    },
    "finish_stability": {
      "type": "number",
      "description": "\u7740\u9806\u5b89\u5b9a\u60270-100"
    },
    "st_stability": {
      "type": "number",
      "description": "ST\u5b89\u5b9a\u60270-100"
    },
    "course_lane_diff": {
      "type": "number",
      "description": "\u67a0\u756a\u3068\u5b9f\u9032\u5165\u30b3\u30fc\u30b9\u306e\u5dee(\u5e73\u5747)"
    },
    "special_count": {
      "type": "number",
      "description": "\u7279\u6b8a\u7d50\u679c\u6570(F/L/K/S\u7b49)"
    },
    "recent10": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "profile": {
      "type": "object",
      "description": "\u9078\u624b\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u60c5\u5831(\u652f\u90e8\u30fb\u51fa\u8eab\u5730\u30fb\u5e74\u9f62)",
      "properties": {
        "branch_name": {
          "type": "string"
        },
        "birthplace": {
          "type": "string"
        },
        "age": {
          "type": "number"
        },
        "birth_date": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ],
      "default": "ok"
    },
    "error": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "registration_number",
    "lane"
  ]
}
{
  "name": "RacerLaneRecentStats",
  "type": "object",
  "description": "\u9078\u624b\u00d7\u67a0\u756a\u3054\u3068\u306e\u76f4\u8fd110\u8d70\u96c6\u8a08\u3002\u4e88\u60f3\u30ed\u30b8\u30c3\u30af\u3068UI\u3067\u4f7f\u7528\u3002",
  "properties": {
    "registration_number": {
      "type": "string"
    },
    "lane": {
      "type": "number",
      "minimum": 1,
      "maximum": 6
    },
    "sample_count": {
      "type": "number",
      "description": "\u7d71\u8a08\u8a08\u7b97\u306b\u4f7f\u3063\u305f\u5b9f\u52b9\u30b5\u30f3\u30d7\u30eb\u6570(\u6709\u7740\u9806\u3042\u308a)"
    },
    "total_lane_count": {
      "type": "number",
      "description": "\u540c\u67a0\u5168\u8d70\u6570(DQ\u7b49\u542b\u3080)"
    },
    "win_rate": {
      "type": "number",
      "description": "1\u7740\u7387%(\u4e88\u60f3\u30a8\u30f3\u30b8\u30f3\u7528)"
    },
    "winning_rate": {
      "type": "number",
      "description": "\u52dd\u7387(\u7740\u9806\u70b9\u5e73\u5747)=\u7740\u9806\u70b9\u5408\u8a08\u00f7\u6709\u52b9\u51fa\u8d70\u6570"
    },
    "top2_rate": {
      "type": "number"
    },
    "top3_rate": {
      "type": "number"
    },
    "avg_st": {
      "type": "number"
    },
    "avg_start_order": {
      "type": "number"
    },
    "recent3_momentum": {
      "type": "number",
      "description": "\u76f4\u8fd13\u8d70\u306e\u52e2\u3044(\u6b63=\u4e0a\u5411\u304d)"
    },
    "finish_stability": {
      "type": "number",
      "description": "\u7740\u9806\u5b89\u5b9a\u60270-100"
    },
    "st_stability": {
      "type": "number",
      "description": "ST\u5b89\u5b9a\u60270-100"
    },
    "course_lane_diff": {
      "type": "number",
      "description": "\u67a0\u756a\u3068\u5b9f\u9032\u5165\u30b3\u30fc\u30b9\u306e\u5dee(\u5e73\u5747)"
    },
    "special_count": {
      "type": "number",
      "description": "\u7279\u6b8a\u7d50\u679c\u6570(F/L/K/S\u7b49)"
    },
    "recent10": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ],
      "default": "ok"
    },
    "error": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "registration_number",
    "lane"
  ]
}
{
  "name": "RacerLaneRecentStats",
  "type": "object",
  "description": "\u9078\u624b\u00d7\u67a0\u756a\u3054\u3068\u306e\u76f4\u8fd110\u8d70\u96c6\u8a08\u3002\u4e88\u60f3\u30ed\u30b8\u30c3\u30af\u3068UI\u3067\u4f7f\u7528\u3002",
  "properties": {
    "registration_number": {
      "type": "string"
    },
    "lane": {
      "type": "number",
      "minimum": 1,
      "maximum": 6
    },
    "sample_count": {
      "type": "number",
      "description": "\u7d71\u8a08\u8a08\u7b97\u306b\u4f7f\u3063\u305f\u5b9f\u52b9\u30b5\u30f3\u30d7\u30eb\u6570(\u6709\u52b9\u7740\u9806\u3042\u308a)"
    },
    "total_lane_count": {
      "type": "number",
      "description": "\u540c\u67a0\u5168\u8d70\u6570(DQ\u7b49\u542b\u3080)"
    },
    "win_rate": {
      "type": "number",
      "description": "1\u7740\u7387%"
    },
    "top2_rate": {
      "type": "number"
    },
    "top3_rate": {
      "type": "number"
    },
    "avg_st": {
      "type": "number"
    },
    "avg_start_order": {
      "type": "number"
    },
    "recent10": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ],
      "default": "ok"
    },
    "error": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "registration_number",
    "lane"
  ]
}
{
  "name": "V7GenerationTrace",
  "type": "object",
  "description": "V7\u4e88\u60f3\u306e\u751f\u6210\u3092\u8a66\u307f\u305f\u7d50\u679c\u3092\u30ec\u30fc\u30b9\u00d7\u6bb5\u968e\u3054\u3068\u306b1\u884c\u3060\u3051\u6b8b\u3059\u8ffd\u8de1\u8a18\u9332\u3002\u5c55\u793a\u30c7\u30fc\u30bf\u306e\u53d6\u5f97\u6642\u523b\u30fb\u751f\u6210\u958b\u59cb\u6642\u523b\u30fb\u751f\u6210\u3067\u304d\u306a\u304b\u3063\u305f\u7406\u7531\u30fb\u4fdd\u5b58\u7d50\u679c\u3092\u8a18\u9332\u3057\u3001FINAL\u304c\u4fdd\u5b58\u3055\u308c\u306a\u304b\u3063\u305f\u539f\u56e0\u3092\u5f8c\u304b\u3089\u8ffd\u3048\u308b\u3088\u3046\u306b\u3059\u308b\u3002\u8a3a\u65ad\u5c02\u7528\u3067\u3001\u4e88\u60f3\u306e\u751f\u6210\u30fb\u4fdd\u5b58\u30fb\u5224\u5b9a\u306b\u306f\u4e00\u5207\u4f7f\u308f\u306a\u3044\u3002\u4e88\u60f3(PredictionV7)\u306e\u66f4\u65b0\u30fb\u524a\u9664\u306f\u884c\u308f\u306a\u3044\u3002\u7de0\u5207\u5f8c\u306e\u751f\u6210\u306f\u884c\u308f\u305a\u3001\u7de0\u5207\u3092\u904e\u304e\u305f\u7d44\u306fBLOCKED(deadline_passed)\u3068\u3057\u3066\u6b8b\u3059\u3002\u66f8\u304d\u8fbc\u307f\u306f\u30b5\u30fc\u30d0\u30fc(V7\u81ea\u52d5\u751f\u6210\u306e\u5171\u901a\u51e6\u7406)\u306e\u307f\u3002",
  "properties": {
    "race_date": {
      "type": "string",
      "format": "date",
      "description": "\u5bfe\u8c61\u65e5"
    },
    "race_key": {
      "type": "string",
      "description": "\u30ec\u30fc\u30b9\u5171\u901a\u30ad\u30fc YYYY-MM-DD_venueCode_raceNumber"
    },
    "race_id": {
      "type": "string"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ],
      "enumColors": [
        "gray",
        "green"
      ],
      "description": "\u5bfe\u8c61\u306e\u6bb5\u968e"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "Race\u306b\u4fdd\u5b58\u3055\u308c\u305f\u7de0\u5207"
    },
    "deadline_passed": {
      "type": "boolean",
      "description": "\u89b3\u6e2c\u6642\u70b9\u3067\u7de0\u5207\u3092\u904e\u304e\u3066\u3044\u305f\u304b(\u7de0\u5207\u5f8c\u306f\u751f\u6210\u3057\u306a\u3044)"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SAVED",
        "PENDING",
        "BLOCKED",
        "FAILED"
      ],
      "enumColors": [
        "green",
        "gray",
        "yellow",
        "red"
      ],
      "description": "SAVED=\u4fdd\u5b58\u6e08\u307f / PENDING=\u7de0\u5207\u524d\u3067\u751f\u6210\u5f85\u3061\u30fb\u4fdd\u7559 / BLOCKED=\u751f\u6210\u5bfe\u8c61\u5916(\u7de0\u5207\u5f8c\u30fb\u7d50\u679c\u78ba\u5b9a\u30fb\u958b\u50ac\u7d42\u4e86) / FAILED=\u751f\u6210\u307e\u305f\u306f\u4fdd\u5b58\u306b\u5931\u6557"
    },
    "reason": {
      "type": "string",
      "description": "\u7406\u7531\u30b3\u30fc\u30c9(saved / exhibition_waiting / deadline_passed / result_confirmed / engine_unavailable / no_plans / input_incomplete / save_rejected / not_attempted / outside_horizon / race_closed)"
    },
    "reason_detail": {
      "type": "string",
      "description": "\u88dc\u8db3(\u4fdd\u5b58\u51e6\u7406\u304c\u8fd4\u3057\u305f\u7406\u7531\u306e\u5185\u8a33\u306a\u3069)"
    },
    "exhibition_ready": {
      "type": "boolean",
      "description": "Race.exhibition_ready(\u5c55\u793a\u53d6\u5f97\u6e08\u307f\u30d5\u30e9\u30b0)"
    },
    "exhibition_usable": {
      "type": "boolean",
      "description": "\u51fa\u8d70\u8868\u306e\u5c55\u793a\u30c7\u30fc\u30bf\u304cFINAL\u5224\u5b9a\u306b\u8db3\u308a\u308b\u304b(\u53d6\u5f97\u6e08\u307f\u30d5\u30e9\u30b0\u3068\u306f\u5225\u5224\u5b9a)"
    },
    "exhibition_active_boats": {
      "type": "number",
      "description": "\u6b20\u5834\u3092\u9664\u3044\u305f\u51fa\u8d70\u8247\u6570"
    },
    "exhibition_fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u5c55\u793a\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3057\u305f\u6642\u523b(OnlineFetchLog\u306e\u5c55\u793a\u53d6\u5f97\u306e\u6700\u7d42\u6642\u523b)"
    },
    "generation_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u751f\u6210\u3092\u958b\u59cb\u3057\u305f\u6642\u523b(\u4fdd\u5b58\u6e08\u307f\u306e\u5834\u5408\u306f\u4e88\u60f3\u306e\u751f\u6210\u6642\u523b)"
    },
    "record_hash": {
      "type": "string",
      "description": "\u4fdd\u5b58\u3055\u308c\u305fPredictionV7\u306erecord_hash"
    },
    "prediction_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u4e88\u60f3\u304cDB\u306b\u4fdd\u5b58\u3055\u308c\u305f\u6642\u523b"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u3053\u306e\u884c\u306e\u72b6\u614b\u3092\u6700\u5f8c\u306b\u89b3\u6e2c\u3057\u305f\u6642\u523b(\u72b6\u614b\u304c\u5909\u308f\u3063\u305f\u3068\u304d\u3060\u3051\u66f4\u65b0)"
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u3053\u306e\u7d44\u3092\u6700\u521d\u306b\u89b3\u6e2c\u3057\u305f\u6642\u523b"
    }
  },
  "required": [
    "race_key",
    "stage"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
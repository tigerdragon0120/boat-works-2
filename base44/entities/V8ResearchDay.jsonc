{
  "name": "V8ResearchDay",
  "type": "object",
  "description": "\u5168\u30ec\u30fc\u30b9\u691c\u8a3c\u306e\u672a\u5b8c\u4e86\u65e5\u30ad\u30e5\u30fc\u3002\u65e5\u4ed8\u304c\u5909\u308f\u3063\u3066\u3082\u672a\u5b8c\u4e86\u5206\u3092\u6b8b\u3057\u3066\u518d\u53d6\u5f97\u30fb\u518d\u69cb\u6210\u30fb\u7d50\u679c\u7167\u5408\u3092\u7d99\u7d9a\u3059\u308b\u3002",
  "properties": {
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "PARTIAL",
        "COMPLETE"
      ]
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_count": {
      "type": "number"
    },
    "recovery_cursor": {
      "type": "number"
    },
    "coverage": {
      "type": "object"
    },
    "input_failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "last_summary": {
      "type": "object"
    },
    "last_error": {
      "type": "string"
    },
    "replay_cursor": {
      "type": "number"
    }
  },
  "required": [
    "race_date",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
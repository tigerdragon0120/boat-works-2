{
  "name": "RacerStatsDataset",
  "type": "object",
  "description": "\u81ea\u52d5\u53d6\u5f97\u3057\u305f\u6700\u65b0\u671f\u306e\u9078\u624b\u6210\u7e3e\u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8\u3002\u53d6\u5f97\u958b\u59cb\u4ee5\u524d\u306e\u671f\u306f\u9061\u53ca\u53d6\u5f97\u305b\u305a\u3001\u4ee5\u5f8c\u306e\u66f4\u65b0\u3092\u84c4\u7a4d\u3002",
  "properties": {
    "dataset_key": {
      "type": "string"
    },
    "term_key": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_index_url": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    },
    "records_hash": {
      "type": "string"
    },
    "record_count": {
      "type": "number"
    },
    "page_count": {
      "type": "number"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "staging",
        "ready"
      ]
    },
    "term_start_date": {
      "type": "string",
      "format": "date"
    },
    "term_end_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "dataset_key",
    "term_key",
    "checksum",
    "records_hash",
    "record_count",
    "page_count",
    "first_seen_at",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
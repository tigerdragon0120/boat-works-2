{
  "name": "OddsSnapshot",
  "type": "object",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ]
    },
    "odds_map": {
      "type": "object",
      "description": "combination -> odds \u306e\u30de\u30c3\u30d7"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "BOATCAST",
        "LOCAL"
      ],
      "description": "\u30aa\u30c3\u30ba\u53d6\u5f97\u5143(BOATCAST=OD3\u512a\u5148\u53d6\u5f97, LOCAL=boatrace.jp\u516c\u5f0f)"
    }
  },
  "required": [
    "race_id",
    "stage"
  ]
}
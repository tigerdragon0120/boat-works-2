        "type": "object",
        "properties": {
          "boat_number": {
            "type": "number"
          },
          "past_score": {
            "type": "number"
          },
          "recent_score": {
            "type": "number"
          },
          "today_score": {
            "type": "number"
          },
          "pre_score": {
            "type": "number"
          },
          "final_delta": {
            "type": "number"
          },
          "final_score": {
            "type": "number"
          },
          "first_score": {
            "type": "number",
            "description": "1\u7740\u9069\u6027\u30b9\u30b3\u30a2 0-100"
          },
          "first_probability": {
            "type": "number",
            "description": "1\u7740\u78ba\u7387%"
          },
          "first_confidence": {
            "type": "number"
          },
          "second_score": {
            "type": "number"
          },
          "second_probability": {
            "type": "number"
          },
          "third_score": {
            "type": "number"
          },
          "third_probability": {
            "type": "number"
          },
          "attack_power": {
            "type": "number",
            "description": "\u5916\u67a0\u653b\u6483\u529b 0-100"
          },
          "inside_escape_score": {
            "type": "number",
            "description": "1\u53f7\u8247\u6642\u306e\u307f: \u30a4\u30f3\u9003\u3052\u4fe1\u983c\u5ea6"
          },
          "past_components": {
            "type": "object"
          },
          "recent_components": {
            "type": "object"
          },
          "today_components": {
            "type": "object"
          },
          "relative_ranks": {
            "type": "object"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "trifectas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "combination": {
            "type": "string"
          },
          "rank": {
            "type": "number"
          },
          "race_probability": {
            "type": "number",
            "description": "\u7d14\u7c8b\u4e88\u6e2c\u78ba\u7387%"
          },
          "actual_odds": {
            "type": "number"
          },
          "expected_value": {
            "type": "number"
          },
          "is_selected": {
            "type": "boolean"
          },
          "ticket_rank": {
            "type": "number"
          }
        }
      }
    },
    "conditional_weights": {
      "type": "object",
      "description": "\u6761\u4ef6\u4ed8\u304d\u91cd\u307f",
      "properties": {
        "past": {
          "type": "number"
        },
        "recent": {
          "type": "number"
        },
        "today": {
          "type": "number"
        },
        "exhibition_st_spread": {
          "type": "number"
        },
        "entry_change_detected": {
          "type": "boolean"
        },
        "rough_water": {
          "type": "boolean"
        }
      }
    },
    "calibration_applied": {
      "type": "object",
      "description": "\u78ba\u7387\u6821\u6b63\u4fc2\u6570",
      "properties": {
        "band": {
          "type": "string"
        },
        "calibration_factor": {
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "data_sources_used": {
      "type": "object",
      "properties": {
        "national": {
          "type": "boolean"
        },
        "local": {
          "type": "boolean"
        },
        "waku10": {
          "type": "boolean"
        },
        "section": {
          "type": "boolean"
        },
        "motor": {
          "type": "boolean"
        },
        "exhibition": {
          "type": "boolean"
        },
        "entry": {
          "type": "boolean"
        },
        "weather": {
          "type": "boolean"
        }
      }

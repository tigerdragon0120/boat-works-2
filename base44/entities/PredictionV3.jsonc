      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "second_ranking": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "third_ranking": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "first_probability_gap": {
      "type": "number",
      "description": "1\u7740\u5019\u88dc1\u4f4d\u30682\u4f4d\u306e\u78ba\u7387\u5dee(pt)"
    },
    "first_confidence": {
      "type": "number",
      "description": "1\u7740\u4e88\u6e2c\u4fe1\u983c\u5ea6 0-100"
    },
    "inside_escape_reliability": {
      "type": "number",
      "description": "1\u53f7\u8247\u30a4\u30f3\u9003\u3052\u4fe1\u983c\u5ea6 0-100"
    },
    "boat_scores": {
      "type": "array",

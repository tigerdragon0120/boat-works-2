{
  "name": "PredictionV3",
  "type": "object",
  "description": "Prediction Engine V3 Candidate\u3002V2\u3092\u57fa\u6e96\u3068\u30571\u7740\u4e88\u6e2c\u7cbe\u5ea6\u3092\u4e2d\u5fc3\u306b\u6539\u5584\u3002\u904e\u53bb25%+\u76f4\u8fd135%+\u5f53\u65e540%\u91cd\u307f\u7dad\u6301\u3001\u6761\u4ef6\u4ed8\u304d\u88dc\u6b63\u8ffd\u52a0\u3002V2\u3068\u306f\u5b8c\u5168\u72ec\u7acb\u3002",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ]
    },
    "prediction_version": {
      "type": "string",
      "default": "v3"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_confidence": {
      "type": "number",
      "description": "\u30c7\u30fc\u30bf\u4fe1\u983c\u5ea6 0-100"
    },
    "data_completeness": {
      "type": "object",
      "description": "\u30c7\u30fc\u30bf\u5b8c\u5168\u6027\u30d5\u30e9\u30b0",
      "properties": {
        "has_entry": {
          "type": "boolean"
        },
        "has_exhibition": {
          "type": "boolean"
        },
        "has_waku10": {
          "type": "boolean"
        },
        "has_odds": {
          "type": "boolean"
        },
        "has_profile": {
          "type": "boolean"
        },
        "is_complete": {
          "type": "boolean"
        }
      }
    },
    "race_type": {
      "type": "string",
      "enum": [
        "INSIDE_CONFIDENT",
        "INSIDE_WEAK",
        "CENTER_ATTACK",
        "ENTRY_CHANGE",
        "MIXED",
        "HIGH_VALUE",
        "DATA_INSUFFICIENT"
      ],
      "description": "\u30ec\u30fc\u30b9\u30bf\u30a4\u30d7\u5206\u985e"
    },
    "race_type_reason": {
      "type": "string"
    },
    "final_judgment": {
      "type": "string",
      "enum": [
        "BUY",
        "WATCH",
        "SKIP"
      ]
    },
    "judgment_reason": {
      "type": "string"
    },
    "buy_conditions": {
      "type": "object",
      "description": "BUY6\u6761\u4ef6\u30c1\u30a7\u30c3\u30af",
      "properties": {
        "A_first_confidence": {
          "type": "boolean"
        },
        "B_set_probability": {
          "type": "boolean"
        },
        "C_odds_available": {
          "type": "boolean"
        },
        "D_expected_recovery": {
          "type": "boolean"
        },
        "E_exhibition_confidence": {
          "type": "boolean"
        },
        "F_data_completeness": {
          "type": "boolean"
        },
        "passed_count": {
          "type": "number"
        }
      }
    },
    "ticket_count": {
      "type": "number",
      "description": "\u8cb7\u3044\u76ee\u6570 6/7/8"
    },
    "selected_trifectas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "set_probability": {
      "type": "number"
    },
    "set_expected_recovery": {
      "type": "number"
    },
    "synthetic_odds": {
      "type": "number"
    },
    "min_payout": {
      "type": "number"
    },
    "avg_payout": {
      "type": "number"
    },
    "max_payout": {
      "type": "number"
    },

    "v3_weights": {
      "type": "object",
      "properties": {
        "past": {
          "type": "number"
        },
        "recent": {
          "type": "number"
        },
        "today": {
          "type": "number"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "MISSING"
      ],
      "default": "COMPLETED"
    }

{
  "name": "V8ExternalPrediction",
  "type": "object",
  "description": "\u7ba1\u7406\u8005\u7528\u306e\u5916\u90e8\u4e88\u60f3\u6bd4\u8f03\u53f0\u5e33\u3002\u624b\u5165\u529b\u30fb\u6301\u8fbc\u8cc7\u6599\u306e\u78ba\u8a8d\u6e08\u307f\u5185\u5bb9\u3092\u8ffd\u8a18\u3002\u516c\u958b\u8ee2\u8f09\u3057\u306a\u3044\u3002\u767a\u8868\u6642\u523b\u3068\u30b5\u30fc\u30d0\u30fc\u8a18\u9332\u6642\u523b\u3092\u533a\u5225\u3057\u3001\u4e8b\u5f8c\u8a18\u9332\u3092\u524d\u5411\u304d\u6210\u7e3e\u304b\u3089\u9664\u5916\u3002",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "DAY_BEFORE",
        "PRE",
        "FINAL"
      ]
    },
    "record_key": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "forecaster_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_uri": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "use_scope": {
      "type": "string"
    },
    "recorded_by_id": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ineligibility_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stake_per_ticket": {
      "type": "number"
    },
    "information_fee": {
      "type": "number"
    },
    "verification_eligible": {
      "type": "boolean"
    },
    "permission_confirmed": {
      "type": "boolean"
    },
    "publisher_verified": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "record_key",
    "revision",
    "race_id",
    "race_key",
    "race_date",
    "stage",
    "published_at",
    "recorded_at",
    "tickets",
    "evidence_type",
    "use_scope"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
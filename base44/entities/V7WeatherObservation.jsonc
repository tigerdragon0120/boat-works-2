{
  "name": "V7WeatherObservation",
  "type": "object",
  "description": "\u30ec\u30fc\u30b9\u6c34\u9762\u6c17\u8c61\u306e\u6642\u70b9\u56fa\u5b9a\u8a18\u9332\u3002\u76f4\u524d\u30da\u30fc\u30b8\u306e\u6c17\u8c61\u306f\u76f4\u8fd1\u30ec\u30fc\u30b9\u53c2\u7167\u5024\u3068\u3057\u3066\u6271\u3046\u3002\u7d50\u679c\u30da\u30fc\u30b8\u306e\u6c17\u8c61\u306e\u307f\u540c\u30ec\u30fc\u30b9\u5b9f\u6e2c\u5019\u88dc\u3068\u3059\u308b\u3002\u7b2c\u4e09\u8005\u306e\u4e88\u5831\u3084\u63a8\u5b9a\u306f\u6df7\u305c\u306a\u3044\u3002",
  "properties": {
    "observation_key": {
      "type": "string"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "PRE_REFERENCE",
        "RESULT_ACTUAL"
      ]
    },
    "source_page": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_display_time": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "weather": {
      "type": "string"
    },
    "wind_dir": {
      "type": "string"
    },
    "wind_speed": {
      "type": "number"
    },
    "wave_height": {
      "type": "number"
    },
    "water_temp": {
      "type": "number"
    },
    "air_temp": {
      "type": "number"
    },
    "wind_class": {
      "type": "string"
    },
    "source_scope": {
      "type": "string"
    },
    "source_age_minutes": {
      "type": "number"
    },
    "quality": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "REJECTED"
      ]
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_boat_win": {
      "type": "boolean"
    },
    "result_trifecta": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "wind_icon_code": {
      "type": "number",
      "description": "\u516c\u5f0fHTML\u306e is-windXX \u30b3\u30fc\u30c9\u3002\u65b9\u4f4d\u3078\u306e\u5909\u63db\u306f\u672a\u691c\u8a3c\u3002"
    },
    "reference_race_number": {
      "type": "number",
      "description": "\u76f4\u524d\u6c17\u8c61\u304c\u76f4\u8fd1\u4f55R\u306e\u89b3\u6e2c\u5024\u304b\u3092\u793a\u3059\u516c\u5f0f\u8868\u793a\uff08\u4f8b:9R\u6642\u70b9\uff09"
    }
  },
  "required": [
    "observation_key",
    "race_id",
    "race_key",
    "race_date",
    "venue_code",
    "race_number",
    "kind",
    "observed_at",
    "deadline",
    "source_scope",
    "quality"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
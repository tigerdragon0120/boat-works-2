{
  "name": "PredictionV7",
  "type": "object",
  "description": "\u7d71\u5408V7\u306e\u7de0\u5207\u524d\u4e88\u60f3\u3092\u7aef\u672b\u304b\u3089\u30b5\u30fc\u30d0\u30fc\u3078\u4fdd\u5b58\u3057\u305f\u4e0d\u5909\u30ec\u30b3\u30fc\u30c9\u3002\u7aef\u672b\u3092\u5909\u3048\u3066\u3082\u5c65\u6b74\u304c\u6b8b\u308a\u3001\u65e5\u6b21\u691c\u8a3c\u306e\u5bfe\u8c61\u306b\u306a\u308b\u3002",
  "properties": {
    "record_hash": {
      "type": "string",
      "description": "\u7aef\u672b\u5074\u306e\u4e0d\u5909\u30ec\u30b3\u30fc\u30c9ID\u3002\u91cd\u8907\u767b\u9332\u306e\u5224\u5b9a\u306b\u4f7f\u7528"
    },
    "input_hash": {
      "type": "string",
      "description": "\u5165\u529b\u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8\u306ehash"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "series_name": {
      "type": "string"
    },
    "is_womens": {
      "type": "boolean"
    },
    "model": {
      "type": "string",
      "enum": [
        "OPEN",
        "WOMENS"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ],
      "enumColors": [
        "gray",
        "green"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u4e88\u60f3\u306e\u751f\u6210\u6642\u523b(\u7de0\u5207\u524d\u3067\u3042\u308b\u3053\u3068)"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "top_combination": {
      "type": "string",
      "description": "\u6700\u3082\u78ba\u7387\u304c\u9ad8\u3044\u4e09\u9023\u5358"
    },
    "top_probability": {
      "type": "number"
    },
    "rank_order": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "1\u301c3\u7740\u306e\u4e88\u60f3\u8247\u756a"
    },
    "plans": {
      "type": "object",
      "description": "\u8cb7\u3044\u76ee\u5019\u88dc\u3002hit_4/hit_6/hit_8/hit_12/value_4/value_6/value_8/value_12 \u306b {tickets, probability, judgment}"
    },
    "coverage": {
      "type": "number",
      "description": "\u5165\u529b\u5145\u8db3\u7387"
    },
    "judgment_reason": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "BROWSER"
      ],
      "enumColors": [
        "gray"
      ]
    }
  },
  "required": [
    "record_hash",
    "race_key",
    "stage"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
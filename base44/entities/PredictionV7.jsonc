{
  "name": "PredictionV7",
  "type": "object",
  "description": "\u7d71\u5408V7\u306e\u7de0\u5207\u524d\u4e88\u60f3\u3092\u4fdd\u5b58\u3057\u305f\u4e0d\u5909\u30ec\u30b3\u30fc\u30c9\u3002\u7aef\u672b\u304b\u3089\u540c\u671f\u3057\u305f\u3082\u306e(BROWSER)\u3068\u30b5\u30fc\u30d0\u30fc\u304c\u81ea\u52d5\u751f\u6210\u3057\u305f\u3082\u306e(SERVER)\u304c\u3042\u308a\u3001\u65e5\u6b21\u691c\u8a3c\u306e\u5bfe\u8c61\u306b\u306a\u308b\u3002\u66f8\u8fbc\u306f\u30b5\u30fc\u30d0\u30fc\u306e\u5171\u901a\u4fdd\u5b58\u51e6\u7406(v7PredictionStore)\u306e\u307f\u3067\u3001\u30a2\u30d7\u30ea\u304b\u3089\u306e\u76f4\u63a5\u4f5c\u6210\u30fb\u66f4\u65b0\u30fb\u524a\u9664\u306f\u3067\u304d\u306a\u3044(\u7ba1\u7406\u8005\u3092\u542b\u3080)\u3002\u78ba\u5b9a\u8a18\u9332\u306f\u66f8\u304d\u63db\u3048\u305a\u3001\u91cd\u8907\u306f\u4fdd\u5b58\u6642\u306e\u30ed\u30c3\u30af\u5185\u78ba\u8a8d\u3067\u9632\u3050\u3002",
  "properties": {
    "record_hash": {
      "type": "string",
      "description": "\u30ec\u30b3\u30fc\u30c9\u306e\u4e00\u610f\u30ad\u30fc\u3002\u7aef\u672b\u306f\u5185\u5bb9hash\u3001\u30b5\u30fc\u30d0\u30fc\u81ea\u52d5\u751f\u6210\u306f server:{race_key}:{stage}"
    },
    "input_hash": {
      "type": "string",
      "description": "\u5165\u529b\u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8\u306ehash"
    },
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "series_name": {
      "type": "string"
    },
    "is_womens": {
      "type": "boolean"
    },
    "model": {
      "type": "string",
      "enum": [
        "OPEN",
        "WOMENS"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ],
      "enumColors": [
        "gray",
        "green"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u4e88\u60f3\u306e\u751f\u6210\u6642\u523b(\u7de0\u5207\u524d\u3067\u3042\u308b\u3053\u3068)"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "top_combination": {
      "type": "string",
      "description": "\u6700\u3082\u78ba\u7387\u304c\u9ad8\u3044\u4e09\u9023\u5358"
    },
    "top_probability": {
      "type": "number"
    },
    "rank_order": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "1\u301c3\u7740\u306e\u4e88\u60f3\u8247\u756a"
    },
    "plans": {
      "type": "object",
      "description": "\u8cb7\u3044\u76ee\u5019\u88dc\u3002hit_4/hit_6/hit_8/hit_12/value_4/value_6/value_8/value_12 \u306b {tickets, probability, judgment}"
    },
    "coverage": {
      "type": "number",
      "description": "\u5165\u529b\u5145\u8db3\u7387"
    },
    "judgment_reason": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "BROWSER",
        "SERVER"
      ],
      "enumColors": [
        "gray",
        "blue"
      ],
      "description": "BROWSER=\u30d1\u30cd\u30eb\u3092\u958b\u3044\u305f\u7aef\u672b\u304c\u751f\u6210 / SERVER=\u30b5\u30fc\u30d0\u30fc\u304c\u7de0\u5207\u524d\u306b\u81ea\u52d5\u751f\u6210"
    }
  },
  "required": [
    "record_hash",
    "race_key",
    "stage"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
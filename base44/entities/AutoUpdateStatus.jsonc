{
  "name": "AutoUpdateStatus",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "default"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u672c\u65e5\u65e5\u4ed8(Asia/Tokyo)"
    },
    "tomorrow_date": {
      "type": "string",
      "format": "date",
      "description": "\u7fcc\u65e5\u65e5\u4ed8"
    },
    "today_venues": {
      "type": "number",
      "description": "\u672c\u65e5\u958b\u50ac\u5834\u6570"
    },
    "today_races": {
      "type": "number",
      "description": "\u672c\u65e5Race\u6570"
    },
    "today_results": {
      "type": "number",
      "description": "\u672c\u65e5\u7d50\u679c\u53d6\u5f97\u6e08\u307fRace\u6570"
    },
    "tomorrow_venues": {
      "type": "number",
      "description": "\u7fcc\u65e5\u958b\u50ac\u5834\u6570"
    },
    "tomorrow_races": {
      "type": "number",
      "description": "\u7fcc\u65e5Race\u6570"
    },
    "tomorrow_entries": {
      "type": "number",
      "description": "\u7fcc\u65e5RaceEntry\u6570"
    },
    "pre_predictions": {
      "type": "number",
      "description": "PRE\u4e88\u60f3\u751f\u6210\u6570"
    },
    "exhibition_fetched": {
      "type": "number",
      "description": "\u5c55\u793a\u30c7\u30fc\u30bf\u53d6\u5f97\u6e08\u307fRace\u6570"
    },
    "odds_fetched": {
      "type": "number",
      "description": "\u30aa\u30c3\u30ba\u53d6\u5f97\u6e08\u307fRace\u6570"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "waiting",
        "partial",
        "retrying",
        "error",
        "success"
      ],
      "default": "idle"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "current_step": {
      "type": "string",
      "description": "\u73fe\u5728\u5b9f\u884c\u4e2d\u30b9\u30c6\u30c3\u30d7"
    },
    "error_count": {
      "type": "number",
      "default": 0
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u76f4\u8fd1\u30a8\u30e9\u30fc(\u6700\u592720\u4ef6)"
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u76f4\u8fd1\u30ed\u30b0(\u6700\u592750\u4ef6)"
    }
  },
  "required": [
    "name"
  ]
}
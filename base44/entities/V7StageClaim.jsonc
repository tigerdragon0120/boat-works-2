{
  "name": "V7StageClaim",
  "type": "object",
  "description": "V7\u4e88\u60f3\u306e\u767b\u9332\u6a29\u3002\u30ec\u30fc\u30b9\u00d7\u6bb5\u968e(race_key::stage)\u3054\u3068\u306b1\u4ef6\u3060\u3051\u3092\u6b63\u3068\u3057\u3001free \u2192 writing \u2192 written \u306e\u72b6\u614b\u9077\u79fb\u3092\u6761\u4ef6\u4ed8\u304d\u66f8\u8fbc(CAS)\u3067\u884c\u3046\u3002\u72b6\u614b\u9077\u79fb\u304c\u6210\u7acb\u3057\u305f1\u3064\u306e\u547c\u3073\u51fa\u3057\u3060\u3051\u304cPredictionV7\u3078\u66f8\u304d\u8fbc\u3081\u308b\u305f\u3081\u3001\u767b\u9332\u6a29\u3068\u4e88\u60f3\u306e\u4e00\u610f\u6027\u306f\u3053\u306e\u884c\u3067\u4fdd\u8a3c\u3055\u308c\u308b(DB\u306e\u4e00\u610f\u5236\u7d04\u304c\u4f7f\u3048\u306a\u3044\u305f\u3081\u3001\u540c\u3058claim_key\u306e\u884c\u304c\u8907\u6570\u3042\u308b\u5834\u5408\u306f\u78ba\u5b9a\u884c\u3092\u6b63\u3068\u3057\u3001\u4f59\u5206\u306afree\u884c\u3092\u524a\u9664\u3057\u30661\u884c\u306b\u63c3\u3048\u308b)\u3002book \u6e08\u307f\u306e\u518d\u9001\u306f already_saved \u3068\u3057\u3066\u6271\u3044\u3001\u4e88\u60f3\u3092\u5897\u3084\u3055\u306a\u3044\u3002\u66f8\u8fbc\u306f\u30b5\u30fc\u30d0\u30fc(\u5171\u901a\u4fdd\u5b58\u51e6\u7406 v7PredictionStore)\u306e\u307f\u3002",
  "properties": {
    "claim_key": {
      "type": "string",
      "description": "\u767b\u9332\u6a29\u30ad\u30fc race_key::stage(\u3053\u306e\u5358\u4f4d\u30671\u4ef6\u306e\u307f)"
    },
    "race_key": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ],
      "enumColors": [
        "gray",
        "green"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "free",
        "writing",
        "written",
        "claimed"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "green"
      ],
      "default": "free",
      "description": "free=\u672a\u53d6\u5f97 / writing=\u66f8\u8fbc\u4e2d(lease\u4e2d\u306f\u4ed6\u306e\u8981\u6c42\u306f\u9032\u3081\u306a\u3044) / written=\u4e88\u60f3\u306e\u4fdd\u5b58\u307e\u3067\u78ba\u5b9a / claimed=\u65e7\u5f62\u5f0f\u306e\u78ba\u5b9a\u72b6\u614b"
    },
    "record_hash": {
      "type": "string",
      "description": "\u767b\u9332\u6a29\u3092\u7372\u5f97\u3057\u305f\u4e88\u60f3\u30ec\u30b3\u30fc\u30c9\u306erecord_hash(\u518d\u9001\u306e\u540c\u4e00\u6027\u5224\u5b9a\u306b\u4f7f\u3046)"
    },
    "owner": {
      "type": "string",
      "description": "\u66f8\u8fbc\u4e2d\u306e\u53d6\u5f97\u30c8\u30fc\u30af\u30f3(record_hash+\u4e71\u6570)\u3002\u6240\u6709\u6a29\u306e\u78ba\u8a8d\u3068\u89e3\u653e\u306e\u6761\u4ef6\u306b\u4f7f\u3046"
    },
    "prediction_id": {
      "type": "string",
      "description": "\u78ba\u5b9a\u3057\u305fPredictionV7\u306e\u30ec\u30b3\u30fc\u30c9ID"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u53d6\u5f97\u6642\u523b\u3002writing \u304c\u3053\u306e\u6642\u523b\u304b\u3089\u4e00\u5b9a\u6642\u9593\u9032\u307e\u306a\u3044\u5834\u5408\u306f\u3001\u5225\u306e\u8981\u6c42\u304c\u5f15\u304d\u7d99\u3052\u308b"
    }
  },
  "required": [
    "claim_key",
    "race_key",
    "stage"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
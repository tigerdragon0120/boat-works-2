{
  "name": "RaceResult",
  "type": "object",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "result_trifecta": {
      "type": "string",
      "description": "\u5b9f\u969b\u306e3\u9023\u5358 (\u4f8b 1-3-5)"
    },
    "finish_order": {
      "type": "array",
      "items": {
        "type": "number"
      },

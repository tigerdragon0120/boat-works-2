{
  "name": "V7BuyShadowTrial",
  "type": "object",
  "description": "V7 FINAL 8\u70b9\u306e\u72ec\u7acb\u3057\u305f\u524d\u5411\u304dBUY\u5019\u88dc\u691c\u8a3c\u53f0\u5e33\u3002\u73fe\u884cBUY\u3084\u4e88\u60f3\u3092\u5909\u66f4\u3057\u306a\u3044\u3002\u30b5\u30fc\u30d0\u30fc\u5b9f\u884c\u6642\u306b\u4e00\u5ea6\u3060\u3051\u4f5c\u6210\u3057\u3001\u66f4\u65b0\u30fb\u524a\u9664\u3057\u306a\u3044\u3002DB created_date\u3068cutoff_at\u306e\u6bd4\u8f03\u3067\u7de0\u5207\u524d\u8a18\u9332\u3092\u5224\u5b9a\u3059\u308b\u3002",
  "properties": {
    "trial_key": {
      "type": "string",
      "description": "\u30eb\u30fc\u30eb\u7248+race_key\u56fa\u5b9a\u30ad\u30fc"
    },
    "rule_version": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_id": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "model": {
      "type": "string",
      "enum": [
        "OPEN",
        "WOMENS"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "FINAL"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "BUY",
        "SKIP",
        "UNDETERMINED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "prediction_hash": {
      "type": "string"
    },
    "prediction_id": {
      "type": "string"
    },
    "prediction_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "odds_id": {
      "type": "string"
    },
    "odds_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "number"
    },
    "inside_count": {
      "type": "number"
    },
    "min_odds": {
      "type": "number"
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sealed_odds": {
      "type": "object"
    },
    "current_buy_judgment": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "trial_key",
    "rule_version",
    "race_key",
    "race_date",
    "decision",
    "cutoff_at",
    "decided_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
{
  "name": "V8ForecastVerification",
  "type": "object",
  "description": "\u7de0\u5207\u524d\u306eV8\u5c55\u958b\u4e88\u60f3\u30fb\u521d\u56de\u7814\u7a76BUY\u30fb\u79c1\u7528\u5916\u90e8\u4e88\u60f3\u3068\u3001LIVE\u53d6\u5f97\u8a3c\u8de1\u4ed8\u304d\u78ba\u5b9a\u7d50\u679c\u306e\u72ec\u7acb\u7167\u5408\u3002\u4e8b\u5f8c\u4e88\u60f3\u30fb\u8fd4\u9084\u30fb\u7af6\u5408\u30fb\u6b20\u640d\u306f\u7684\u4e2d\u7387\u3068\u56de\u53ce\u7387\u306b\u542b\u3081\u306a\u3044\u3002",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "DAY_BEFORE",
        "PRE",
        "FINAL"
      ]
    },
    "verification_key": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "forecast_id": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "forecaster_name": {
      "type": "string"
    },
    "result_id": {
      "type": "string"
    },
    "result_trifecta": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "actual_winning_method": {
      "type": "string"
    },
    "source_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buy_tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_payout": {
      "type": "number"
    },
    "research_stake": {
      "type": "number"
    },
    "research_return": {
      "type": "number"
    },
    "buy_stake": {
      "type": "number"
    },
    "buy_return": {
      "type": "number"
    },
    "information_fee": {
      "type": "number"
    },
    "net_return": {
      "type": "number"
    },
    "research_hit": {
      "type": "boolean"
    },
    "buy_selected": {
      "type": "boolean"
    },
    "buy_hit": {
      "type": "boolean"
    },
    "scenario_leader_hit": {
      "type": "boolean"
    },
    "winning_method_hit": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "verification_key",
    "revision",
    "source_kind",
    "race_id",
    "race_key",
    "race_date",
    "stage",
    "result_id",
    "evidence_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
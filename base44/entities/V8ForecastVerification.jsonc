{
  "name": "V8ForecastVerification",
  "type": "object",
  "description": "\u5168\u30ec\u30fc\u30b9\u306e\u6bb5\u968e\u5225\u4e88\u60f3\u3092\u516c\u5f0f\u7d50\u679c\u3068\u7167\u5408\u3002\u7de0\u5207\u524d\u306eLIVE\u5b9f\u7e3e\u3068\u4e8b\u5f8c\u518d\u69cb\u6210REPLAY\u306e\u7814\u7a76\u6210\u7e3e\u3092\u533a\u5225\u3057\u3066\u84c4\u7a4d\u3059\u308b\u3002",
  "properties": {
    "race_id": {
      "type": "string"
    },
    "race_key": {
      "type": "string"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "DAY_BEFORE",
        "PRE",
        "FINAL"
      ]
    },
    "verification_key": {
      "type": "string"
    },
    "source_kind": {
      "type": "string"
    },
    "forecast_id": {
      "type": "string"
    },
    "external_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "forecaster_name": {
      "type": "string"
    },
    "result_id": {
      "type": "string"
    },
    "result_trifecta": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "actual_winning_method": {
      "type": "string"
    },
    "source_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buy_tickets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_payout": {
      "type": "number"
    },
    "research_stake": {
      "type": "number"
    },
    "research_return": {
      "type": "number"
    },
    "buy_stake": {
      "type": "number"
    },
    "buy_return": {
      "type": "number"
    },
    "information_fee": {
      "type": "number"
    },
    "net_return": {
      "type": "number"
    },
    "research_hit": {
      "type": "boolean"
    },
    "buy_selected": {
      "type": "boolean"
    },
    "buy_hit": {
      "type": "boolean"
    },
    "scenario_leader_hit": {
      "type": "boolean"
    },
    "winning_method_hit": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    },
    "record_mode": {
      "type": "string",
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "description": "\u7167\u5408\u5143\u4e88\u60f3\u306e\u8a18\u9332\u533a\u5206\u3002REPLAY\u306f\u7de0\u5207\u524dBUY\u306e\u6210\u7e3e\u306b\u542b\u3081\u306a\u3044\u3002"
    }
  },
  "required": [
    "verification_key",
    "revision",
    "source_kind",
    "race_id",
    "race_key",
    "race_date",
    "stage",
    "result_id",
    "evidence_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "none"
      }
    },
    "update": {
      "user_condition": {
        "role": "none"
      }
    },
    "delete": {
      "user_condition": {
        "role": "none"
      }
    }
  }
}
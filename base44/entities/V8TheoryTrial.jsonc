      "type": "string"
    },
    "snapshot_key": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "source_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "baseline_top": {
      "type": "string"
    },
    "baseline_tickets": {
      "type": "array",
      "items": {

{
  "name": "EngineCalibration",
  "type": "object",
  "description": "\u65e5\u6b21\u691c\u8a3c\u306e\u7d50\u679c\u304b\u3089\u7b97\u51fa\u3057\u305f\u4e88\u60f3\u30a8\u30f3\u30b8\u30f3\u306e\u88dc\u6b63\u5024\u3002\u4e88\u60f3\u30bb\u30c3\u30c8\u7684\u4e2d\u7387\u306e\u5e2f\u3054\u3068\u306b\u5b9f\u6e2c\u52dd\u7387\u3092\u4fdd\u6301\u3057\u3001\u6b21\u56de\u4ee5\u964d\u306e\u4e88\u60f3\u306b\u53cd\u6620\u3059\u308b\u3002",
  "properties": {
    "engine": {
      "type": "string",

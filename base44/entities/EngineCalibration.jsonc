      "type": "number",
      "description": "\u7684\u4e2d\u6570"
    },
    "measured_rate": {
      "type": "number",
      "description": "\u5b9f\u6e2c\u306e\u30bb\u30c3\u30c8\u7684\u4e2d\u7387(%)"
    },
    "avg_predicted": {
      "type": "number",
      "description": "\u4e88\u60f3\u30bb\u30c3\u30c8\u7684\u4e2d\u7387\u306e\u5e73\u5747(%)"
    },
    "calibration_factor": {
      "type": "number",
      "description": "\u5b9f\u6e2c\u00f7\u4e88\u60f3\u306e\u88dc\u6b63\u4fc2\u6570"
    },
    "bands": {
      "type": "array",
      "description": "\u4e88\u60f3\u30bb\u30c3\u30c8\u7684\u4e2d\u7387\u306e\u5e2f\u3054\u3068\u306e\u5b9f\u6e2c\u52dd\u7387",
      "items": {
        "type": "object",
        "properties": {

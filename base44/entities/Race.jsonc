{
  "name": "Race",
  "type": "object",
  "properties": {
    "race_key": {
      "type": "string",
      "description": "\u5171\u901a\u30ad\u30fc YYYY-MM-DD_venueCode_raceNumber"
    },
    "venue": {
      "type": "string",
      "description": "\u7af6\u8247\u5834\u540d(\u8868\u793a\u7528)"
    },
    "venue_code": {
      "type": "string",
      "description": "\u7af6\u8247\u5834\u30b3\u30fc\u30c9"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number",
      "description": "\u30ec\u30fc\u30b9\u756a\u53f7"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "race_name": {
      "type": "string",
      "description": "\u30ec\u30fc\u30b9\u540d"
    },
    "race_type": {
      "type": "string",
      "enum": [
        "\u4e88\u9078",
        "\u4e00\u822c",
        "\u6e96\u512a",
        "\u512a\u52dd",
        "\u305d\u306e\u4ed6"
      ],
      "default": "\u4e00\u822c"
    },
    "race_phase": {
      "type": "string",
      "description": "\u4e88\u9078/\u4e00\u822c/\u6e96\u512a/\u512a\u52dd \u306a\u3069(BOAT WORKS\u7531\u6765)"
    },
    "grade": {
      "type": "string",
      "description": "\u30ec\u30fc\u30b9\u30b0\u30ec\u30fc\u30c9 (SG/G1/G2/\u4e00\u822c)"
    },
    "time_slot": {
      "type": "string",
      "description": "\u958b\u50ac\u6642\u9593\u5e2f"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "description": "\u7de0\u5207\u6642\u523b"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "pre",
        "final",
        "finished",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "weather": {
      "type": "string"
    },
    "wind_dir": {
      "type": "string"
    },
    "wind_speed": {
      "type": "number"
    },
    "wave_height": {
      "type": "number"
    },
    "water_temp": {
      "type": "number"
    },
    "air_temp": {
      "type": "number"
    },
    "exhibition_ready": {
      "type": "boolean",
      "default": false,
      "description": "\u5c55\u793a\u30c7\u30fc\u30bf\u53d6\u5f97\u6e08\u307f"
    },
    "scratched_boats": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "\u6b20\u5834\u8247\u756a\u53f7\u4e00\u89a7"
    },
    "prediction_grade": {
      "type": "string",
      "enum": [
        "S",
        "A",
        "B",
        "C"
      ]
    },
    "honmei_boat": {
      "type": "number"
    },
    "taiko_boat": {
      "type": "number"
    },
    "ana_boat": {
      "type": "number"
    },
    "keshi_boat": {
      "type": "number"
    },
    "top_trifecta": {
      "type": "string"
    },
    "top_probability": {
      "type": "number"
    },
    "final_judgment": {
      "type": "string",
      "enum": [
        "STRONG_BUY",
        "BUY",
        "WATCH",
        "SKIP",
        "PENDING"
      ]
    },
    "has_pre": {
      "type": "boolean",
      "default": false
    },
    "has_final": {
      "type": "boolean",
      "default": false
    },
    "sync_source": {
      "type": "string",
      "description": "\u30c7\u30fc\u30bf\u540c\u671f\u5143(api/ingest/manual)"
    }
  },
  "required": [
    "race_number",
    "race_date"
  ]
}
    "od3_status": {
      "type": "string",
      "description": "OD3\u53d6\u5f97\u72b6\u614b: WAITING\u2192FETCHED\u2192PARSED\u2192MATCHED\u2192VERIFIED\u2192READY\u3002READY\u306fDB\u4fdd\u5b58\u5f8c\u518dREAD\u691c\u8a3c\u6e08\u307f\u306e\u307f\u3002",

      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "PRE",
        "FINAL"
      ]
    },
    "prediction_version": {
      "type": "string",
      "default": "v4"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },

    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u30ea\u30fc\u30b9\u6709\u52b9\u671f\u9650\u3002\u8d85\u904e\u5f8c\u306f\u4ed6\u30ef\u30fc\u30ab\u30fc\u304c\u5f37\u596a\u53ef\u80fd"
